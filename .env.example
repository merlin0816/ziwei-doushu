# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 注意：开源版不含 /api/interpret 等后端接口，下面这组配置只在你自己实现了接口后才会用到；
# 只想排盘、看命盘的话不用填。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── 本站增补：AI 讲解 / 原版解读接口 ───
# LLM_API_KEY 是唯一必须填的；下面三项留空即用代码默认值
# （LLM_BASE_URL 的代码默认值是作者自建网关，部署到别处请务必改掉）
LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash
# LLM_TIMEOUT_MS=180000

# 数据集缓存目录（容器内路径，docker-compose 已挂 ./data）
# ZIWEI_DATA_DIR=/data/cache